# backend/.env is read at startup (by app/recommend.py); shell variables take precedence. Never commit .env.
EDGESENSE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
EDGESENSE_DB_PATH=data/edgesense.sqlite3
EDGESENSE_RETENTION_DAYS=7
# Optional for localhost demo; REQUIRED before exposing the service remotely.
# EDGESENSE_API_KEY=replace-with-a-random-demo-key

# Live demo LLM suggestions (/recommend). Without a key, /recommend uses a built-in template.
OPENAI_API_KEY=
# Optional: LLM_MODEL=gpt-4o
# Optional (e.g. a watsonx / other OpenAI-compatible endpoint): OPENAI_BASE_URL=
